{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeepMeTube",
  "version": "26.2.0",
  "identifier": "com.keepmetube.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KeepMeTube",
        "width": 960,
        "height": 680,
        "minWidth": 700,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/Tetracon05/KeepMeTube/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBNDdFNUUwM0IyMTUzQ0MKUldUTVV5RTc0T1ZIcXVpbk5DUVc3ZmZ3ZWdGanFZYjBvNEMyelhNR2l3WTJQZUppU3prdlZsLzAK"
    }
  }
}

